# Pal's settings. Copy to .env (git-ignored) and fill in only what you use; everything is optional.
# Never commit real keys: .env is in .gitignore, and Pal never saves keys anywhere.
#   docker run --env-file .env ...      or      python run.py   (reads .env)      or set them in your shell.

# -- API models (leave empty to use only a local model through Ollama) ---------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
# The coding and documentation agents can each use their own Gemini key (default: GEMINI_API_KEY)
GEMINI_API_KEY_CODING=
GEMINI_API_KEY_DOCS=

# -- Any OpenAI-compatible endpoint (a company gateway, a hosted open model) ----------------------------------------------
PAL_CUSTOM_BASE_URL=
PAL_CUSTOM_API_KEY=

# -- Where Pal keeps its data (plans, memory, indexed documents). Default: ~/.pal ---------------------------------------
# PAL_HOME=

# -- Any setting from src/pal/config/default.yaml, as PAL__<SECTION>__<KEY> --------------------------------------------
# The local model server (Ollama). In Docker, point it at the host:
# PAL__LOCAL_LLM__HOST=http://host.docker.internal:11434
# The web server (keep 127.0.0.1 outside a container: Pal has no login)
# PAL__SERVER__HOST=127.0.0.1
# PAL__SERVER__PORT=5000

# -- Optional ---------------------------------------------------------------------------------------------------------
# PAL_WHISPER_MODEL=base          # the speech-to-text model for the mic
# PAL_SKIP_SETUP=1                # do not check Ollama or download models at start
